# O firebase 11 declara peer opcional do async-storage ^1.18.1, mas o Expo SDK 58 usa a 2.x.
# Cada versão do npm resolve esse conflito de um jeito (o do PC e o do EAS divergem),
# então ignoramos os peers para os dois montarem a mesma árvore.
# Remover quando o firebase for atualizado para uma versão com peer ^2.2.0.
legacy-peer-deps=true
